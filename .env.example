# ZimaOS MCP Server Configuration
# Copy this file to .env and fill in your values

# ZimaOS API Base URL (e.g., http://zimacube.local or http://192.168.1.100)
ZIMAOS_API_BASE=http://your-zimaos-host.local

# ZimaOS API Token (get this from your ZimaOS administration panel)
ZIMAOS_API_TOKEN=your-api-token-here

# ZimaOS SSH Configuration (required for Docker management)
# SSH Password (required)
ZIMAOS_SSH_PASSWORD=your-ssh-password

# SSH Host (optional - will be auto-detected from ZIMAOS_API_BASE if not set)
# ZIMAOS_SSH_HOST=your-zimaos-host.local

# SSH Username (optional - defaults to 'zimaos', can also use ZIMAOS_USER)
# ZIMAOS_SSH_USERNAME=zimaos
# ZIMAOS_USER=bobdivx

# SSH Port (optional - defaults to 22)
# ZIMAOS_SSH_PORT=22

# Activepieces API Configuration (optional - for managing Activepieces flows)
# Activepieces API Base URL (e.g., http://zimacube.local/activepieces/api or http://localhost:8080/api)
# If not set, will try to auto-detect from ZIMAOS_API_BASE
# ACTIVEPIECES_API_BASE=http://your-zimaos-host.local/activepieces/api

# Activepieces API Key (get this from Activepieces platform dashboard)
# ACTIVEPIECES_API_KEY=your-activepieces-api-key
