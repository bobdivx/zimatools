# ZimaTools — copier vers .env

# Transport MCP: http (NAS / DevForge / Cursor distant) ou stdio (Cursor local)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_ENDPOINT=/mcp
MCP_CORS_ORIGIN=*

# API REST pour l'UI (Hono)
API_PORT=8766
API_CORS_ORIGIN=*

# Conteneur web : proxy /api + /health vers le service mcp (Docker Compose)
API_UPSTREAM=http://mcp:8766

# URL API vue par le navigateur (laisser vide = same-origin via le proxy web)
PUBLIC_API_URL=

# ZimaOS API (outils fichiers)
ZIMAOS_API_BASE=http://your-zimaos-host.local
ZIMAOS_API_TOKEN=your-api-token-here

# SSH Docker (si le serveur MCP ne tourne pas sur le NAS)
ZIMAOS_SSH_PASSWORD=your-ssh-password
# ZIMAOS_SSH_HOST=your-zimaos-host.local
# ZIMAOS_SSH_USERNAME=zimaos
# ZIMAOS_SSH_PORT=22
