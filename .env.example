# ZimaTools — copier vers .env

# Transport MCP: http (NAS / DevForge / Cursor distant) ou stdio (Cursor local)
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_ENDPOINT=/mcp
MCP_CORS_ORIGIN=*

# API REST pour l'UI (Hono)
API_PORT=8766
API_CORS_ORIGIN=*

# Conteneur web (sidecar): API/MCP sur localhost du netns mcp
API_UPSTREAM=http://127.0.0.1:8766
MCP_UPSTREAM=http://127.0.0.1:8765

# URL publique du connecteur (issuer OAuth, métadonnées, logo). Obligatoire derrière un proxy.
# Exemple production : https://zimatools.jeser.app
# PUBLIC_BASE_URL=https://zimatools.jeser.app

# Mot de passe de la page de consentement OAuth (Grok). 12 caractères minimum recommandés.
# Ce n'est pas un jeton MCP : il ne donne pas accès aux outils.
# ZIMATOOLS_ADMIN_PASSWORD=

# Jeton Bearer statique optionnel pour l'automatisation déjà en place (Cursor, scripts).
# Longue durée, à part des jetons OAuth (1 h / refresh 90 j). 16 caractères minimum recommandés.
# ZIMATOOLS_MCP_TOKEN=

# Port loopback du MCP interne (non publié). Le port public MCP_PORT est le connecteur OAuth.
# MCP_INTERNAL_PORT=8767

# URL API vue par le navigateur (laisser vide = same-origin via le proxy web)
PUBLIC_API_URL=

# ZimaOS API (outils fichiers)
ZIMAOS_API_BASE=http://your-zimaos-host.local
ZIMAOS_API_TOKEN=your-api-token-here

# SSH Docker (si le serveur MCP ne tourne pas sur le NAS)
ZIMAOS_SSH_PASSWORD=your-ssh-password
# ZIMAOS_SSH_HOST=your-zimaos-host.local
# ZIMAOS_SSH_USERNAME=zimaos
# ZIMAOS_SSH_PORT=22

# Watchdog images — optionnel : sinon secret auto généré (visible sur /apps)
# IMAGE_WEBHOOK_SECRET=change-me-long-random
# ZIMATOOLS_DATA_DIR=/data
