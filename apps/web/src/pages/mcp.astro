---
import Layout from "../layouts/Layout.astro";
import McpPanel from "../components/McpPanel";
---

<Layout title="ZimaTools — MCP">
  <div class="mb-6">
    <div class="zima-kicker">Protocole</div>
    <h1 class="text-3xl font-bold mt-1">Serveur MCP</h1>
    <p class="opacity-60 mt-2 max-w-2xl">
      Configure Cursor, DevForge ou tout client MCP Streamable HTTP. Cette page est pour le navigateur ;
      l'endpoint agent reste la meme URL <code class="font-mono text-secondary">/mcp</code>.
    </p>
  </div>
  <McpPanel client:load />
</Layout>
