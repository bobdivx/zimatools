---
import Layout from "../layouts/Layout.astro";
import GpuPanel from "../components/GpuPanel";
---

<Layout title="ZimaTools — GPU">
  <div class="mb-6">
    <div class="zima-kicker">Outil</div>
    <h1 class="text-3xl font-bold mt-1">Console GPU</h1>
