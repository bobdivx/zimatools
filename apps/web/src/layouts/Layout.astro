---
import "../styles/global.css";
import Nav from "../components/Nav";

interface Props {
  title?: string;
}

const { title = "ZimaTools" } = Astro.props;
---

<html lang="fr" data-theme="zima">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div class="zima-shell">
      <Nav pathname={Astro.url.pathname} />
      <main class="zima-main">
        <slot />
      </main>
    </div>
  </body>
</html>
