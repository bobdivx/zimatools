# ZimaTools MCP

MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
MCP_ENDPOINT=/mcp
API_PORT=8766

ZIMAOS_API_BASE=http://your-zimaos-host.local
ZIMAOS_API_TOKEN=your-api-token-here
ZIMAOS_SSH_PASSWORD=your-ssh-password

# Webhook images — optionnel (sinon secret auto, visible sur /apps après session admin)
# IMAGE_WEBHOOK_SECRET=change-me-long-random

# Connecteur OAuth (Grok). Issuer public — obligatoire derrière un reverse proxy.
# PUBLIC_BASE_URL=https://zimatools.jeser.app
# Mot de passe du consentement et de la session du tableau de bord (pas un Bearer).
# ZIMATOOLS_ADMIN_PASSWORD=
# Jeton Bearer statique optionnel pour scripts / Cursor et pour /api/*.
# ZIMATOOLS_MCP_TOKEN=
# MCP_INTERNAL_PORT=8767
